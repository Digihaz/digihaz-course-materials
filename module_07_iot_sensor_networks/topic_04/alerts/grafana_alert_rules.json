{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "digihaz_landslide_alerts",
      "folder": "DigiHaz",
      "interval": "1m",
      "rules": [
        {
          "uid": "digihaz-red-alert",
          "title": "🚨 Landslide RED — Critical Threshold Breach",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {"from": 600, "to": 0},
              "datasourceUid": "${DS_INFLUXDB}",
              "model": {
                "refId": "A",
                "query": "from(bucket: \"digihaz_sensors\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"sensors\")\n  |> filter(fn: (r) => r._field == \"tilt_deg\" or r._field == \"soil_pct\")\n  |> pivot(rowKey:[\"_time\", \"site\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.tilt_deg > 10.0 and r.soil_pct > 90.0)\n  |> last()\n  |> map(fn: (r) => ({ r with _value: 1.0 }))\n  |> keep(columns: [\"_time\", \"site\", \"_value\"])",
                "queryType": "",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {"from": 0, "to": 0},
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {"type": "__expr__", "uid": "__expr__"},
                "conditions": [
                  {
                    "evaluator": {"params": [0], "type": "gt"},
                    "operator": {"type": "and"},
                    "query": {"params": ["A"]},
                    "reducer": {"params": [], "type": "last"},
                    "type": "query"
                  }
                ],
                "expression": "A"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "🚨 RED ALERT: Landslide imminent at {{ $labels.site }}",
            "description": "Tilt exceeded 10° AND soil moisture exceeded 90% for 2+ minutes. Evacuate the area immediately. View dashboard: {{ .ExternalURL }}",
            "runbook_url": "https://github.com/Digihaz/digihaz-course-materials/blob/dev/module_07_iot_sensor_networks/topic_04/alerts/RUNBOOK.md"
          },
          "labels": {
            "severity": "critical",
            "category": "landslide",
            "team": "digihaz",
            "site": "{{ $labels.site }}"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "DigiHaz Telegram"
          }
        },
        {
          "uid": "digihaz-yellow-alert",
          "title": "⚠ Landslide YELLOW — Elevated Risk",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {"from": 600, "to": 0},
              "datasourceUid": "${DS_INFLUXDB}",
              "model": {
                "refId": "A",
                "query": "from(bucket: \"digihaz_sensors\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"sensors\")\n  |> filter(fn: (r) => r._field == \"tilt_deg\" or r._field == \"soil_pct\")\n  |> pivot(rowKey:[\"_time\", \"site\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.tilt_deg > 5.0 and r.soil_pct > 80.0 and not (r.tilt_deg > 10.0 and r.soil_pct > 90.0))\n  |> last()\n  |> map(fn: (r) => ({ r with _value: 1.0 }))\n  |> keep(columns: [\"_time\", \"site\", \"_value\"])",
                "queryType": "",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {"from": 0, "to": 0},
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {"type": "__expr__", "uid": "__expr__"},
                "conditions": [
                  {
                    "evaluator": {"params": [0], "type": "gt"},
                    "operator": {"type": "and"},
                    "query": {"params": ["A"]},
                    "reducer": {"params": [], "type": "last"},
                    "type": "query"
                  }
                ],
                "expression": "A"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "⚠ YELLOW: Elevated landslide risk at {{ $labels.site }}",
            "description": "Tilt > 5° AND soil > 80% sustained 2+ min. Monitor the site closely; prepare evacuation plans.",
            "runbook_url": "https://github.com/Digihaz/digihaz-course-materials/blob/dev/module_07_iot_sensor_networks/topic_04/alerts/RUNBOOK.md"
          },
          "labels": {
            "severity": "warning",
            "category": "landslide",
            "team": "digihaz",
            "site": "{{ $labels.site }}"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "DigiHaz Telegram"
          }
        },
        {
          "uid": "digihaz-storm-alert",
          "title": "🌀 Storm Approaching — Pressure Drop",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {"from": 3600, "to": 0},
              "datasourceUid": "${DS_INFLUXDB}",
              "model": {
                "refId": "A",
                "query": "from(bucket: \"digihaz_sensors\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sensors\")\n  |> filter(fn: (r) => r._field == \"press_hpa\")\n  |> aggregateWindow(every: 10m, fn: mean, createEmpty: false)\n  |> derivative(unit: 1h, nonNegative: false)\n  |> last()",
                "queryType": "",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {"from": 0, "to": 0},
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {"type": "__expr__", "uid": "__expr__"},
                "conditions": [
                  {
                    "evaluator": {"params": [-2.0], "type": "lt"},
                    "operator": {"type": "and"},
                    "query": {"params": ["A"]},
                    "reducer": {"params": [], "type": "last"},
                    "type": "query"
                  }
                ],
                "expression": "A"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "🌀 Storm approaching at {{ $labels.site }}",
            "description": "Atmospheric pressure dropped more than 2 hPa/hour — storm system likely within hours. Soil saturation is the next concern.",
            "runbook_url": "https://github.com/Digihaz/digihaz-course-materials/blob/dev/module_07_iot_sensor_networks/topic_04/alerts/RUNBOOK.md"
          },
          "labels": {
            "severity": "warning",
            "category": "weather",
            "team": "digihaz",
            "site": "{{ $labels.site }}"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "DigiHaz Browser"
          }
        },
        {
          "uid": "digihaz-offline",
          "title": "📡 Sensor Offline — No Data",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {"from": 900, "to": 0},
              "datasourceUid": "${DS_INFLUXDB}",
              "model": {
                "refId": "A",
                "query": "from(bucket: \"digihaz_sensors\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"sensors\")\n  |> filter(fn: (r) => r._field == \"tilt_deg\")\n  |> group(columns: [\"site\"])\n  |> count()",
                "queryType": "",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {"from": 0, "to": 0},
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "datasource": {"type": "__expr__", "uid": "__expr__"},
                "conditions": [
                  {
                    "evaluator": {"params": [1], "type": "lt"},
                    "operator": {"type": "and"},
                    "query": {"params": ["A"]},
                    "reducer": {"params": [], "type": "last"},
                    "type": "query"
                  }
                ],
                "expression": "A"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "📡 Sensor at {{ $labels.site }} offline",
            "description": "No measurements received in the last 10 minutes. Check power, network, or sensor hardware."
          },
          "labels": {
            "severity": "info",
            "category": "infrastructure",
            "team": "digihaz",
            "site": "{{ $labels.site }}"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "DigiHaz Browser"
          }
        }
      ]
    }
  ]
}
